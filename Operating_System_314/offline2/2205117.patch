+uint64
+sys_trace(void)
+{
+  int syscall_num;
+  struct proc *p = myproc();
+  argint(0,&syscall_num);
+  p->trace_syscall = syscall_num;
+  return 0;
+}
+
+uint64 sys_history(void){
+  int syscall_num;
+  uint64 stat_pr;
+  struct proc *p = myproc();
+  argint(0, &syscall_num);
+  argaddr(1,&stat_pr);
+
+  if(syscall_num < 0 || syscall_num >= MAX_SYSCALLS) {
+    return -1;
+  }
+
+  struct syscall_stat stat;
+  acquire(&global_stats.lock);
+
+  if(syscall_num == -1) return -1;
+  else stat = global_stats.stats[syscall_num];
+
+  release(&global_stats.lock);
+
+  if(copyout(p->pagetable,stat_pr,(char*)&stat,sizeof(stat)) <0){
+    return -1;
+  }
+  return 0;
+}
