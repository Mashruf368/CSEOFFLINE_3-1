+void print_trace_info(struct proc *p,int num,uint64 args[],char *saved_str){
+  printf("pid: %d, syscall: %s, args (",p->pid,syscall_names[num]);
+  switch(num) {
+    case SYS_open:
+      printf("%s",saved_str);
+      printf(", %ld", args[1]);
+      break;
+    case SYS_read:
+    case SYS_write:
+      printf("%ld", args[0]);
+      printf(", 0x%lx", args[1]);
+      printf(", %ld", args[2]);
+      break;
+    case SYS_exec:
+      printf("%s",saved_str);
+      printf(", 0x%lx", args[1]);
+      break;
+    case SYS_close:
+      printf("%ld", args[0]);
+      break;
+    default:
+      for(int i=0;i<6;i++){
+        if(i>0) {
+          printf(", ");
+        }
+        printf("%ld", args[i]);
+      }
+
+  }
+  printf("), return: %ld\n",p->trapframe->a0);
+}
+
 void
 syscall(void)
 {
   int num;
   struct proc *p = myproc();
+  int start_time = ticks;
 
   num = p->trapframe->a7;
   if(num > 0 && num < NELEM(syscalls) && syscalls[num]) {
     // Use num to lookup the system call function for num, call it,
     // and store its return value in p->trapframe->a0
+  uint64 saved_args[6];
+  char saved_str[64];
+
+  for(int i = 0; i < 6; i++)
+    {saved_args[i] = argraw(i);}
+
+  if (num == SYS_exec || num == SYS_open){
+    argstr(0,saved_str,sizeof(saved_str));
+  }
+
+    //printf("before syscall a0=%ld\n", p->trapframe->a0);
     p->trapframe->a0 = syscalls[num]();
+    if(global_stats.initialized){
+      update_syscall_stats(num,start_time);
+    }
+    //printf("after syscall a0=%ld\n", p->trapframe->a0);
+
+    if(p->trace_syscall == num) {
+      print_trace_info(p,num,saved_args,saved_str);
+    }
   } else {
     printf("%d %s: unknown sys call %d\n",
             p->pid, p->name, num);
     p->trapframe->a0 = -1;
   }
 }
+
+void update_syscall_stats(int syscall_num,int start_time){
+  acquire(&global_stats.lock);
+
+  int elapsed_time = ticks - start_time;
+
+  global_stats.stats[syscall_num].count++;
+  global_stats.stats[syscall_num].time += elapsed_time;
+
+  release(&global_stats.lock);
+}
+
+void init_syscall_stats(void){
+  initlock(&global_stats.lock,"syscall_stats");
+  global_stats.initialized = 1;
+
+  for(int i=0;i<NELEM(global_stats.stats);i++){
+    if(i<NELEM(syscall_names) && syscall_names[i]){
+      safestrcpy(global_stats.stats[i].syscall_name,syscall_names[i],16);
+
+    }
+    global_stats.stats[i].count = 0;
+    global_stats.stats[i].time  = 0;
+
+  }
+}
+
+uint64 return_all_stats(struct proc *p){
+  uint64 user_buf;
+  struct syscall_stat all_stats[MAX_SYSCALLS];
+
+  argaddr(1, &user_buf);
+  acquire(&global_stats.lock);
+  memmove(all_stats,global_stats.stats,sizeof(all_stats));
+  release(&global_stats.lock);
+
+  if(copyout(p->pagetable,user_buf,(char*)all_stats,sizeof(all_stats))<0)
+  {
+    return -1;
+  }
+  return 0;
+}
+
