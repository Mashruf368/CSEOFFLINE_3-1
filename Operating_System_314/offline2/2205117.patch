diff --git a/user/history.c b/user/history.c
new file mode 100644
index 0000000..f2dedbe
--- /dev/null
+++ b/user/history.c
@@ -0,0 +1,22 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int main(int argc, char *argv[]){
+    struct syscall_stat stat;
+
+    if(argc == 1){
+        for(int i=1;i<=23;i++){
+            if(history(i,&stat) == 0){
+                printf("%d: syscall: %s, #: %d, time: %d\n",i,stat.syscall_name,stat.count,stat.time);
+            }
+        }
+    }
+    else{
+        int num = atoi(argv[1]);
+        if(history(num,&stat) == 0){
+            printf("%d: syscall: %s, #: %d, time: %d\n",num,stat.syscall_name,stat.count,stat.time);
+        }
+    }
+    exit(0);
+}
